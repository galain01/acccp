{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/cron/purge-documents", "schedule": "0 3 * * *" }],
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "renderer",
          "format": "url",
          "env": "GOTENBERG_URL"
        },
        {
          "type": "service",
          "service": "native-pdf",
          "format": "url",
          "env": "NATIVE_PDF_URL"
        }
      ]
    },
    "renderer": {
      "root": "services/renderer",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "native-pdf": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.native-pdf.vercel"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
